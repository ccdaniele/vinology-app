# Copy to .env (dotenv-rails loads this automatically).

# Required in production. Development falls back to a local-only default if unset.
JWT_SECRET=replace-me-with-a-long-random-string

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Postgres — Postgres.app: leave DB_USERNAME/DB_PASSWORD unset (uses your macOS user).
# Docker Compose: set DB_USERNAME=postgres and DB_PASSWORD=password (see docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vinology_development
DB_NAME_TEST=vinology_test
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DATABASE_URL=postgres://postgres:password@localhost:5432/vinology_development
